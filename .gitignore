# Root gitignore for MyFolio monorepo

# Dependencies
node_modules/
vendor/

# Next.js build outputs
frontend/.next/
frontend/out/
frontend/build/

# Production build outputs
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Laravel storage & logs
backend/storage/*.key
backend/storage/app/public/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
!backend/storage/app/public/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.gemini/
